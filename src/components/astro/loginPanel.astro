---
import LoginForm from "../LoginForm.vue";
import { Image } from "astro:assets";
// Opción A: Importar la imagen si está en src/assets/ (RECOMENDADO para optimización)
// import avatarUser from "../assets/avatar-user.jpg"; 
---

<section class="bg-base-100 text-base-content min-h-screen grid grid-cols-1 lg:grid-cols-2 overflow-hidden relative w-full">
  <!-- Elementos Ambientales Decorativos (Orbes de Neón traseros) -->
  <div class="fixed top-[-15%] right-[-15%] w-96 h-96 bg-primary/10 rounded-full blur-3xl -z-10 animate-pulse" style="animation-duration: 4s;"></div>
  <div class="fixed bottom-[-15%] left-[-15%] w-96 h-96 bg-secondary/15 rounded-full blur-3xl -z-10 animate-pulse" style="animation-duration: 5s;"></div>

  <!-- Detalles Tecnológicos en Esquinas Globales -->
  <div class="absolute top-8 left-8 z-10 hidden sm:block">
    <div class="w-16 h-16 border-l-2 border-t-2 border-primary/30"></div>
    <div class="flex gap-1 mt-2">
      <div class="w-1 h-1 rounded-full bg-primary/50"></div>
      <div class="w-1 h-1 rounded-full bg-primary/30"></div>
      <div class="w-1 h-1 rounded-full bg-primary/20"></div>
    </div>
  </div>

  <div class="absolute top-8 right-8 z-10 hidden sm:block">
    <div class="w-16 h-16 border-r-2 border-t-2 border-secondary/30"></div>
    <div class="flex gap-1 mt-2 justify-end">
      <div class="w-1 h-1 rounded-full bg-secondary/20"></div>
      <div class="w-1 h-1 rounded-full bg-secondary/30"></div>
      <div class="w-1 h-1 rounded-full bg-secondary/50"></div>
    </div>
  </div>

  <!-- COLUMNA IZQUIERDA: Arreglado el flujo dimensional eliminando w-full innecesario -->
  <div class="relative hidden lg:flex min-h-screen flex-col items-center justify-center border-r border-base-content/10 bg-neutral/20 backdrop-blur-sm overflow-hidden select-none">
    <!-- Patrón de malla cibernética de fondo -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:24px_24px]"></div>
    
    <!-- Orbe de neón interno -->
    <div class="absolute w-64 h-64 bg-primary/20 rounded-full blur-2xl animate-pulse"></div>

    <!-- Contenedor del Logotipo -->
    <div class="relative z-10 flex flex-col items-center gap-6 p-8 text-center">
      <div class="relative w-40 h-40 flex items-center justify-center border border-primary/40 rounded-xl bg-base-100/50 backdrop-blur-md shadow-[0_0_50px_rgba(var(--p),0.1)] before:absolute before:inset-0 before:border-2 before:border-dashed before:border-primary/20 before:rounded-xl before:animate-[spin_40s_linear_infinite]">
        
        <!-- Glifo / Imagen -->
        <div class="w-[120px] h-[120px] rounded-lg overflow-hidden animate-bounce z-20" style="animation-duration: 3s;">
          <img src="/avatar-user.jpg" alt="Avatar del usuario" class="w-full h-full object-cover" />
        </div>

        <!-- Líneas de escaneo estéticas -->
        <div class="absolute inset-x-0 h-[2px] bg-primary/30 top-0 animate-[scan_2s_linear_infinite]"></div>
      </div>

      <!-- Textos del Proyecto -->
      <div class="space-y-2">
        <h1 class="text-3xl font-black tracking-[0.2em] uppercase text-base-content">
          Rate<span class="text-primary">App</span>
        </h1>
        <p class="text-xs tracking-widest text-base-content/60 font-mono">[ SYSTEM_ACCESS: STABLE_NODE ]</p>
      </div>
    </div>

    <!-- Líneas de datos simuladas -->
    <div class="absolute bottom-8 left-8 font-mono text-[10px] text-base-content/30 space-y-1">
      <p>SYS_STATUS: ACTIVE</p>
      <p>NETWORK: SECURE_CORE_9</p>
    </div>
  </div>

  <!-- COLUMNA DERECHA: Forzada a mantener min-h-screen en todo momento para respetar el grid -->
  <main class="relative flex min-h-screen flex-col justify-between items-center p-6 sm:p-12">
    
    <!-- Contenedor invisible superior para empujar el formulario al centro -->
    <div class="flex-1"></div>

    <!-- Contenedor del Formulario (Centrado en el flujo) -->
    <div class="w-full max-w-sm bg-base-100/40 lg:bg-transparent p-6 sm:p-0 rounded-2xl border border-base-content/5 lg:border-none backdrop-blur-md lg:backdrop-blur-none shadow-2xl lg:shadow-none z-10">
      <LoginForm client:load />
    </div>

    <!-- Footer integrado -->
    <footer class="w-full text-center text-[10px] sm:text-xs pt-12 pb-2 font-mono flex-1 flex items-end justify-center">
      <p class="font-medium tracking-widest text-base-content/40">
        © 2026 Rate App
      </p>
    </footer>
  </main>
</section>

<style>
  @keyframes scan {
    0% { top: 0%; opacity: 0; }
    5% { opacity: 1; }
    95% { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }
</style>