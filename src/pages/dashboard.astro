---
import BaseLayout from '../layouts/BaseLayout.astro'
import ProfileCard from '../components/ProfileCard.vue'
import RestaurantGrid from '../components/RestaurantGrid.vue'
import HeaderPage from '../components/UI/HeaderPage.vue'

// Importaciones de servicios para el servidor
import { restaurantService } from '../lib/api'

// 1. CONTROL DE ACCESO EN EL SERVIDOR
// Leemos la cookie o token de sesión directamente en el servidor
const sessionToken = Astro.cookies.get('auth_token')?.value;

if (!sessionToken) {
  return Astro.redirect('/login');
}

// 2. PETICIONES EN PARALELO DESDE EL SERVIDOR (Ultra rápido)
let userData = null;
let initialRestaurants = [];

try {
  // Realizamos las llamadas utilizando el token del servidor
  const [userResponse, restResponse] = await Promise.all([
    fetch('https://tuweb.com', {
      headers: { 'Authorization': `Bearer ${sessionToken}` }
    }).then(res => res.json()),
    
    restaurantService.search('', undefined, 1)
  ]);

  userData = userResponse.user ?? { name: 'Explorador', totalPoints: 0, totalReviews: 0 };
  initialRestaurants = restResponse.restaurants ?? [];
} catch (error) {
  console.error('Error cargando datos en SSR:', error);
}

const filterTabs = ['Todos', 'Tendencia', 'Promocionados'];
---

<BaseLayout>
  <main class="flex-1 min-w-0">
    <!-- Header estático: No se hidrata en el cliente (0% JavaScript adicional) -->
    <HeaderPage title="Dashboard" subtitle="Descubre nuevos restaurantes cerca de tí" />

    <div class="px-6 md:px-10 py-8 space-y-8 max-w-350 mx-auto">
      <div class="flex flex-col gap-4">
        <!-- Pasamos userData como prop inicial para pintarlo al instante -->
        <ProfileCard initialUser={userData} client:load />
      </div>

      <section>
        <div class="flex items-end justify-between mb-5">
          <div>
            <h2 class="font-display text-2xl font-bold">Restaurantes para tí </h2>
            <p class="text-sm text-muted-foreground mt-1">Basado en tu ubicación</p>
          </div>
          <div class="hidden md:flex gap-2">
            {filterTabs.map((t, i) => (
              <button
                class={`px-4 h-9 rounded-full text-sm font-medium transition border ${
                  i === 0
                    ? 'bg-foreground text-background border-foreground'
                    : 'border-border/60 text-muted-foreground hover:text-foreground hover:border-lime/40'
                }`}
              >
                {t}
              </button>
            ))}
          </div>
        </div>

        <!-- Pasamos la lista de restaurantes precargada -->
        <RestaurantGrid initialRestaurants={initialRestaurants} client:load />
      </section>

      <footer class="py-10 text-center text-xs text-muted-foreground">
        © 2026 rateapp 
      </footer>
    </div>
  </main>
</BaseLayout>
