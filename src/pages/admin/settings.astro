const sessionToken = Astro.cookies.get('auth_token')?.value;

if (!sessionToken) {
  return Astro.redirect('/login');
}

const payload = verifyToken(sessionToken);

if (!payload || payload.sys !== 'RESTAURANT') {
  return Astro.redirect('/login');
}

let userData = null;
let restaurantId: number | null = null;

try {
  const meResponse = await fetch(new URL('/api/auth/me', Astro.url.origin).toString(), {
    headers: {
      Cookie: `auth_token=${sessionToken}`,
      Accept: 'application/json',
    },
  });

  if (meResponse.ok) {
    const meData = await meResponse.json();
    userData = meData.user ?? null;
    restaurantId = Number(userData?.restaurant_id ?? payload.restaurant_id) || null;
  } else {
    // no bloquear el acceso si /api/auth/me falla; permitimos que el usuario vea el dashboard
    restaurantId = payload.restaurant_id ? Number(payload.restaurant_id) : null;
  }
} catch (error) {
  console.error('Error cargando sesión del restaurante:', error);
  restaurantId = payload.restaurant_id ? Number(payload.restaurant_id) : null;
}
