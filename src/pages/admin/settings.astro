---
/**
 * @file restaurant-admin.astro
 * @description Panel de administración para usuarios con rol RESTAURANT.
 * @depends src/components/RestaurantDashboard.vue, src/lib/auth
 */


import AdminBaseLayout from '../../layouts/AdminBaseLayout.astro';
import RestaurantDashboard from '../../components/RestaurantDashboard.vue';
import SubmitImages from '../../components/UI/submitImages.vue';
import { verifyToken } from '../../lib/auth';

const sessionToken = Astro.cookies.get('auth_token')?.value;

if (!sessionToken) {
  return Astro.redirect('/login');
}

const payload = verifyToken(sessionToken);

if (!payload || payload.sys !== 'RESTAURANT') {
  return Astro.redirect('/login');
}

let userData = null;
let restaurantId: number | null = null;
let restaurantImage: string | null = null;

try {
  const meResponse = await fetch(new URL('/api/auth/me', Astro.url.origin).toString(), {
    headers: {
      Cookie: `auth_token=${sessionToken}`,
      Accept: 'application/json',
    },
  });

  if (meResponse.ok) {
    const meData = await meResponse.json();
    userData = meData.user ?? null;
    restaurantId = Number(userData?.restaurant_id ?? payload.restaurant_id) || null;
  } else {
    // no bloquear el acceso si /api/auth/me falla; permitimos que el usuario vea el dashboard
    restaurantId = payload.restaurant_id ? Number(payload.restaurant_id) : null;
  }
} catch (error) {
  console.error('Error cargando sesión del restaurante:', error);
  restaurantId = payload.restaurant_id ? Number(payload.restaurant_id) : null;
}

// Obtener datos del restaurante (imagen) si tenemos id
if (restaurantId) {
  try {
    const rResp = await fetch(new URL(`/api/restaurant?id=${restaurantId}`, Astro.url.origin).toString(), {
      headers: {
        Accept: 'application/json',
      },
    });

    if (rResp.ok) {
      const rData = await rResp.json();
      restaurantImage = rData.restaurant?.image ?? null;
    }
  } catch (err) {
    console.error('Error cargando restaurante:', err);
  }
}
---

<AdminBaseLayout title="Ajustes del restaurante — Admin">
  <RestaurantDashboard restaurantId={restaurantId} client:load />
  <div style="margin-top:24px">
    <h3>Imagen del restaurante</h3>
    <SubmitImages restaurantId={restaurantId} initialImage={restaurantImage} client:load />
  </div>
</AdminBaseLayout>
