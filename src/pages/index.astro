---
import LayoutPage from "../layouts/LayoutPage.astro";
---

<LayoutPage>
	<section class="min-h-dvh max-w-full overflow-x-hidden bg-base-100">
		<header class="sticky top-0 z-50 backdrop-blur-md bg-base-100/85">
			<div
				class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between"
			>
				<a href="/" class="flex items-center gap-2">
					<span
						class="font-display italic text-2xl font-semibold text-primary"
						>RateApp</span
					>
				</a>
				<nav class="flex items-center gap-2 sm:gap-4">
					<a
						href="#como-funciona"
						class="hidden md:inline text-sm text-base-content/70 hover:text-base-content transition-colors px-2"
						>Cómo funciona</a
					>
					<a
						href="#negocios"
						class="hidden md:inline text-sm text-base-content/70 hover:text-base-content transition-colors px-2"
						>Para negocios</a
					>
					<a
						href="/login"
						class="text-sm font-medium px-4 py-2 rounded-full text-base-content/80 hover:text-base-content hover:bg-base-200 transition-colors"
						>Iniciar sesión</a
					>
					<a
						href="/dashboard"
						class="text-sm font-semibold px-4 py-2 rounded-full bg-primary text-primary-content hover:brightness-110 transition shadow-lg shadow-primary/20"
						>Ir al dashboard</a
					>
				</nav>
			</div>
		</header>

		<main>
			<section
				class="w-full relative px-6 my-4 pt-24 pb-32 overflow-hidden"
			>
				<div class="relative max-w-7xl mx-auto">
					<div
						class="lg:col-span-6 flex flex-col md:flex-row gap-7 py-12 mt-6"
					>
						<div>
							<h1
								class="font-display text-5xl md:text-6xl xl:text-7xl leading-[1.03] tracking-tight text-base-content"
							>
								Pide la cuenta.
								<br />
								<span class="italic font-medium text-primary"
									>Nosotros ya sabemos</span
								>
								<br />
								si valía la pena.
							</h1>

							<p
								class="text-base-content/65 text-lg leading-relaxed max-w-md"
							>
								Encuentra reseñas de usuarios reales, comparte
								tus opiniones y ademas recibe recompensas por
								ello.
							</p>

							<div class="flex flex-wrap items-center gap-4 pt-4">
								<a
									href="/dashboard"
									class="group inline-flex items-center gap-2 bg-primary text-primary-content font-semibold px-6 py-4 rounded-full shadow-xl shadow-primary/25 hover:brightness-110 transition"
								>
									Ir al dashboard
									<svg
										class="w-4 h-4 transition-transform group-hover:translate-x-1"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
										stroke-width="2.5"
										><path
											stroke-linecap="round"
											stroke-linejoin="round"
											d="M14 5l7 7m0 0l-7 7m7-7H3"
										></path></svg
									>
								</a>
								<a
									href="#como-funciona"
									class="text-base-content/70 hover:text-base-content font-medium px-2 py-3.5 transition-colors"
								>
									Cómo funciona ↓
								</a>
							</div>
						</div>
						<div>
							<img
								src="https://pub-d80845b9e313461db9d75fa6897f1bf3.r2.dev/Devices_Pictures.png"
								alt="devicesPicture"
								class="w-fit h-fit"
							/>
						</div>
					</div>
				</div>
			</section>

			<section
				id="como-funciona"
				class="px-6 py-24 bg-base-200 border-y border-base-300"
			>
				<div class="max-w-7xl mx-auto py-12">
					<div class="reveal max-w-2xl mb-16" data-reveal>
						<span
							class="course-eyebrow text-xs text-secondary uppercase"
							>¿Como funciona?</span
						>
						<h2
							class="font-display text-4xl md:text-5xl mt-3 leading-tight"
						>
							Tres funciones, <span class="italic text-primary"
								>una experiencia completa</span
							>
						</h2>
					</div>

					<div class="flex flex-col md:flex-row gap-4 py-4">
						<div
							class="aura reveal"
							data-reveal
							style="transition-delay:.08s"
						>
							<div class="card bg-base-100">
								<div class="card-body flex flex-col gap-4">
									<span
										class="course-eyebrow text-[11px] text-primary uppercase"
										>Encuentra</span
									>
									<h3 class="font-display text-2xl">
										Descubre lo que buscas
									</h3>
									<p
										class="text-base-content/60 text-sm leading-relaxed"
									>
										Filtra por lo que de verdad importa,
										todo tipo de restaurantes para todos los
										gustos.
									</p>
								</div>
							</div>
						</div>

						<div
							class="aura reveal"
							data-reveal
							style="transition-delay:.08s"
						>
							<div class="card bg-base-100">
								<div class="card-body flex flex-col gap-4">
									<span
										class="course-eyebrow text-[11px] text-primary uppercase"
										>Reseñas</span
									>
									<h3 class="font-display text-2xl">
										Califica en detalle
									</h3>
									<p
										class="text-base-content/60 text-sm leading-relaxed"
									>
										Comida, servicio, ambiente e iluminación
										se puntúan por separado. Tu reseña se
										lee como se lee una cuenta: clara, ítem
										por ítem.
									</p>
								</div>
							</div>
						</div>

						<div
							class="aura reveal"
							data-reveal
							style="transition-delay:.08s"
						>
							<div class="card bg-base-100">
								<div class="card-body flex flex-col gap-4">
									<span
										class="course-eyebrow text-[11px] text-primary uppercase"
										>Recompensas</span
									>
									<h3 class="font-display text-2xl">
										Gana y canjea
									</h3>
									<p
										class="text-base-content/60 text-sm leading-relaxed"
									>
										Cada reseña deja puntos. Los cambias por
										cupones reales en los restaurantes que
										ya conoces.
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section>
				<div class="max-w-7xl w-full px-6 py-24 flex mx-auto">
					<div
						class="w-full lg:col-span-6 reveal flex flex-col md:flex-row md:justify-between gap-6"
						data-reveal
					>
						<div>
							<span
								class="course-eyebrow text-xs text-secondary uppercase"
								>Puntos & recompensas</span
							>
							<h2
								class="font-display text-4xl md:text-5xl leading-tight"
							>
								Tus opiniones te <span
									class="italic text-primary">dan</span
								> recompensas que si te benefician.
							</h2>
							<p
								class="text-base-content/65 leading-relaxed max-w-md"
							>
								Cada aporte suma puntos directos a tu billetera.
								Escribe reseñas detalladas y canjealos por
								cupones en la tienda..
							</p>

							
						</div>

						<a href="#" class="hover-3d cursor-pointer">
							<!-- content -->
							<div
								class="card md:w-200 bg-black text-white bg-[radial-gradient(circle_at_bottom_left,#ffffff04_35%,transparent_36%),radial-gradient(circle_at_top_right,#ffffff04_35%,transparent_36%)] bg-size-[4.95em_4.95em]"
							>
								<div class="card-body">
									<div class="flex justify-between mb-10">
										<div class="font-bold">
											RateApp Wallet
										</div>
										<div class="text-5xl opacity-10">❁</div>
									</div>
									<div class="text-lg mb-4 opacity-40">
										0210 8820 1150 0222
									</div>
									<div class="flex justify-between">
										<div>
											<div class="text-xs opacity-20">
												CARD USER
											</div>
											<div>Carlos Enrique</div>
										</div>
										<div>
											<div class="text-xs opacity-20">
												PUNTOS
											</div>
											<div>247</div>
										</div>
									</div>
								</div>
							</div>

							<!-- 8 empty divs needed for the 3D effect -->
							<div></div>
							<div></div>
							<div></div>
							<div></div>
							<div></div>
							<div></div>
							<div></div>
							<div></div>
						</a>
					</div>
				</div>
			</section>

			<!-- ═══ PARA NEGOCIOS ═══ -->
			<section
				id="negocios"
				class="px-6 py-24 bg-base-200 border-y border-base-300"
			>
				<div class="max-w-7xl mx-auto">
					<div class="reveal max-w-2xl mb-16" data-reveal>
						<span
							class="course-eyebrow text-xs text-secondary uppercase"
							>Para restaurantes y socios</span
						>
						<h2
							class="font-display text-4xl md:text-5xl mt-3 leading-tight"
						>
							La cocina detrás de <span
								class="italic text-primary">tus datos</span
							>
						</h2>
						<p class="text-base-content/60 mt-4 leading-relaxed">
							Conecta con comensales que ya saben qué buscan — y
							muéstrales exactamente por qué eres tú.
						</p>
					</div>

					<div class="grid md:grid-cols-3 gap-6">
						<div
							class="reveal bg-base-100 border border-base-300 rounded-2xl p-7 hover:border-secondary/50 transition-colors"
							data-reveal
						>
							<div class="text-3xl mb-4">📈</div>
							<h3 class="font-display text-xl mb-2">
								Visibilidad calificada
							</h3>
							<p
								class="text-base-content/60 text-sm leading-relaxed"
							>
								Muestra tus puntos fuertes reales — música,
								espacio, menú — a quien busca justamente eso.
							</p>
						</div>
						<div
							class="reveal bg-base-100 border border-base-300 rounded-2xl p-7 hover:border-secondary/50 transition-colors"
							data-reveal
							style="transition-delay:.08s"
						>
							<div class="text-3xl mb-4">📊</div>
							<h3 class="font-display text-xl mb-2">
								Analítica en vivo
							</h3>
							<p
								class="text-base-content/60 text-sm leading-relaxed"
							>
								Ve cómo perciben tu servicio día a día, sin
								esperar una encuesta trimestral.
							</p>
						</div>
						<div
							class="reveal bg-base-100 border border-base-300 rounded-2xl p-7 hover:border-secondary/50 transition-colors"
							data-reveal
							style="transition-delay:.16s"
						>
							<div class="text-3xl mb-4">🎯</div>
							<h3 class="font-display text-xl mb-2">
								Promociones dirigidas
							</h3>
							<p
								class="text-base-content/60 text-sm leading-relaxed"
							>
								Crea cupones propios dentro del sistema de
								puntos para llenar mesas en horas bajas.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- ═══ CTA FINAL ═══ -->
			<section
				class="relative px-6 py-28 bg-neutral text-neutral-content text-center overflow-hidden"
			>
				<div
					class="absolute -top-24 left-1/2 -translate-x-1/2 h-72 w-72 rounded-full bg-primary/20 blur-[100px] pointer-events-none"
				>
				</div>
				<div class="relative max-w-2xl mx-auto reveal" data-reveal>
					
					<h2
						class="font-display text-4xl md:text-6xl mt-4 leading-tight"
					>
						Tu próxima <span class="italic text-primary"
							>restaurante favorito</span
						> está a un paso.
					</h2>
					<p
						class="text-neutral-content/60 text-lg mt-5 leading-relaxed"
					>
						Entra a tu panel, descubre lugares cerca de ti o
						administra tu propio restaurante.
					</p>
					<a
						href="/dashboard"
						class="inline-flex items-center gap-3 mt-8 bg-primary text-primary-content font-semibold px-8 py-4 rounded-full shadow-xl shadow-primary/30 hover:brightness-110 transition"
					>
						Ir al dashboard
						<svg
							class="w-5 h-5"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							stroke-width="2.5"
							><path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg
						>
					</a>
				</div>
			</section>

			<footer
				class="footer sm:footer-horizontal bg-base-200 text-base-content p-10"
			>
				<aside>
					<img
						src="/avatar-user.jpg"
						alt="logo_rateapp"
						class="w-24 h-24"
					/>

					<p>RateApp 2026</p>
					<br />
				</aside>
				<nav>
					<h6 class="footer-title">Funcionamiento</h6>
					<a class="link link-hover" href="#como-funciona"
						>Como Funciona</a
					>
					<a class="link link-hover" href="negocios">Para Negocios</a>
				</nav>
				<nav>
					<h6 class="footer-title">Servicios</h6>
					<a class="link link-hover">Iniciar Sesión</a>
					<a class="link link-hover">Ir al dashboard</a>
				</nav>
			</footer>

			<script>
				const items = document.querySelectorAll("[data-reveal]");
				const io = new IntersectionObserver(
					(entries) => {
						entries.forEach((e) => {
							if (e.isIntersecting) {
								e.target.classList.add("in");
								io.unobserve(e.target);
							}
						});
					},
					{ threshold: 0.15 },
				);
				items.forEach((el) => io.observe(el));
			</script>

			<style is:global>
				html {
					scroll-behavior: smooth;
				}

				.dashed-rule {
					border-bottom: 1.5px dashed #c9b98f;
				}

				.stamp {
					border: 2.5px solid var(--color-primary);
					color: var(--color-primary);
					transform: rotate(-11deg);
					border-radius: 9999px;
					opacity: 0.9;
				}

				.barcode {
					background-image: repeating-linear-gradient(
						90deg,
						#2a1b12 0px,
						#2a1b12 2px,
						transparent 2px,
						transparent 5px,
						#2a1b12 5px,
						#2a1b12 6px,
						transparent 6px,
						transparent 10px
					);
					height: 34px;
				}

				.reveal {
					opacity: 0;
					transform: translateY(18px);
					transition:
						opacity 0.7s ease,
						transform 0.7s ease;
				}
				.reveal.in {
					opacity: 1;
					transform: translateY(0);
				}

				.course-eyebrow {
					font-family: "IBM Plex Mono", monospace;
					letter-spacing: 0.14em;
				}

				::selection {
					background: var(--color-primary);
					color: var(--color-primary-content);
				}

				@media (prefers-reduced-motion: reduce) {
					.reveal {
						opacity: 1;
						transform: none;
						transition: none;
					}
					html {
						scroll-behavior: auto;
					}
				}
			</style>
		</main>
	</section>
</LayoutPage>
