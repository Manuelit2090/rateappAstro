---

import AppSideBar from '../components/AppSidebarAdmin.vue'
import MobileDock from '../components/MobileDock.vue'
import AlertContainer from '../components/UI/alertContainer.vue'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'rateapp — Admin Dashboard',
  description = 'Panel de control para administradores de restaurantes.',
} = Astro.props
---

<!doctype html>
<html lang="en" data-theme="sunset">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="rateapp" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Global styles (Tailwind + CSS vars) -->
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
     <div class="flex w-full bg-background text-foreground">
      <AlertContainer client:visible />
      <AppSideBar class="md:block hidden" client:visible/>
      <MobileDock class="md:hidden" client:visible/>
    <slot />
     </div>
  </body>
</html>
